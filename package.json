{
  "name": "leiten-zustand",
  "version": "1.8.0-alpha.0",
  "private": false,
  "description": "Zustand state manager controllers",
  "repository": {
    "type": "git",
    "url": "https://github.com:hecmatyar/leiten-zustand.git"
  },
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "source": "dist/index.ts",
  "jsnext:main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "check:lint": "eslint src/**/*.{ts,tsx,js}",
    "build:ts": "del-cli dist && tsc --noEmit false",
    "check:ts": "tsc --noEmit",
    "fix:lint": "eslint src/**/*.{ts,tsx,js} --fix",
    "fix:prettier": "prettier --write src/**/*.{json}",
    "sort:package": "npx sort-package-json"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "tsc --noEmit"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": []
  },
  "dependencies": {
    "idb": "^8.0.3",
    "js-md5": "^0.9.2",
    "nanoid": ">=4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "clean-publish": "^7.1.0",
    "del-cli": "^7.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "immer": "^11.1.21",
    "lint-staged": "^17.6.0",
    "lodash-es": "^4.18.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "typescript": "^6.0.3",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "immer": ">=10",
    "lodash-es": ">=4",
    "nanoid": ">=4",
    "react": ">=17",
    "zustand": ">=5"
  },
  "engines": {
    "node": ">=17",
    "npm": ">=8"
  },
  "engineStrict": true,
  "publishConfig": {
    "homepage": "https://github.com/Hecmatyar/leiten-zustand"
  },
  "license": "MIT",
  "keywords": [
    "zustand",
    "fetching",
    "state",
    "store",
    "helpers",
    "constrollers",
    "lenses"
  ]
}
